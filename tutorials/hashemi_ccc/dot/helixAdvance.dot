digraph "TandoorHashemi.helixAdvance" {
  rankdir=BT;
  node [fontname=Helvetica];
  n0 [label="pitch", shape=box];
  n1 [label="phi", shape=box];
  n2 [label="*", shape=ellipse];
  n0 -> n2; n1 -> n2;
  n3 [label="2", shape=plaintext];
  n4 [label="π", shape=plaintext];
  n5 [label="*", shape=ellipse];
  n3 -> n5; n4 -> n5;
  n6 [label="/", shape=ellipse];
  n2 -> n6; n5 -> n6;
  out0 [label="out 0", shape=box, style=filled, fillcolor=lightgrey]; n6 -> out0;
}