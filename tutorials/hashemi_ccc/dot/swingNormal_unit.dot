digraph "TandoorHashemi.swingNormal_unit" {
  rankdir=BT;
  node [fontname=Helvetica];
  n0 [label="t", shape=box];
  n1 [label="sin", shape=ellipse];
  n0 -> n1;
  n2 [label="neg", shape=ellipse];
  n1 -> n2;
  n3 [label="cos", shape=ellipse];
  n0 -> n3;
