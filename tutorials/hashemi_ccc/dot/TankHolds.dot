digraph "TandoorHashemi.TankHolds" {
  rankdir=BT;
  node [fontname=Helvetica];
  n0 [label="Vtank", shape=box];
  n1 [label="Vloop", shape=box];
  n2 [label="frac", shape=box];
  n3 [label="*", shape=ellipse];
  n1 -> n3; n2 -> n3;
  n4 [label="<=", shape=ellipse];
  n3 -> n4; n0 -> n4;
  out0 [label="out 0", shape=box, style=filled, fillcolor=lightgrey]; n4 -> out0;
}