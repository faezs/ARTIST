digraph "TandoorHashemi.sigmoid_mono" {
  rankdir=BT;
  node [fontname=Helvetica];
  n0 [label="x", shape=box];
  n1 [label="y", shape=box];
  n2 [label="<=", shape=ellipse];
  n0 -> n2; n1 -> n2;
  n3 [label="sigmoid", shape=ellipse];
  n0 -> n3;
  n4 [label="sigmoid", shape=ellipse];
  n1 -> n4;
  n5 [label="<=", shape=ellipse];
  n3 -> n5; n4 -> n5;
  n6 [label="->", shape=ellipse];
  n2 -> n6; n5 -> n6;
  out0 [label="out 0", shape=box, style=filled, fillcolor=lightgrey]; n6 -> out0;
}