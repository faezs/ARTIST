digraph "TandoorHashemi.wireStretch" {
  rankdir=BT;
  node [fontname=Helvetica];
  n0 [label="T", shape=box];
  n1 [label="L", shape=box];
  n2 [label="E", shape=box];
  n3 [label="A", shape=box];
